# Copia a .env y ejecuta scripts/init_env.py para generar secretos locales.
# Nunca expongas variables privadas como VITE_ ni publiques .env.
APP_NAME=Vigía Financiera
ENVIRONMENT=development
COMPOSE_PROJECT_NAME=vigia-financiera
PUBLIC_APP_URL=http://localhost:8080
WEB_PORT=8080
API_PORT=8000
POSTGRES_DB=vigia
POSTGRES_USER=vigia
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://vigia:CAMBIAR@db:5432/vigia
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@vigia.local
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Copia chrome-extension://ID desde chrome://extensions tras instalarla.
EXTENSION_ORIGIN=
REQUIRE_MFA_ROLES=admin,analyst
MFA_ISSUER=Vigía Financiera
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=900
EVALUATION_DAILY_LIMIT=100
MAX_REQUEST_BYTES=131072
RETENTION_DAYS=90
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=4
JOB_LEASE_SECONDS=300
MAX_REPORT_ROWS=10000
REPORT_MAX_BYTES=20000000
# Reportes persistidos en PostgreSQL, no se sirven desde una carpeta pública.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Vigía Financiera <noreply@vigia.local>
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_NOTIFICATIONS_ENABLED=true
MAILPIT_UI_PORT=8025
# Gmail: smtp.gmail.com, 587+STARTTLS o 465+SSL; contraseña de aplicación local.
# Conectar Gmail al chat no configura automáticamente el SMTP de Docker.
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
REPUTATION_CACHE_SECONDS=21600
REPUTATION_TIMEOUT_SECONDS=5
REPUTATION_MIN_INTERVAL_SECONDS=16
REPUTATION_DAILY_LIMIT=450
BANK_DOMAINS_JSON='{"BCP":{"domains":["viabcp.com"],"aliases":["bcp","viabcp"]},"Interbank":{"domains":["interbank.pe"],"aliases":["interbank"]},"BBVA":{"domains":["bbva.pe"],"aliases":["bbva"]}}'
RISK_MODERATE_THRESHOLD=25
RISK_HIGH_THRESHOLD=50
RISK_CRITICAL_THRESHOLD=75
AI_ENABLED=false
OPENAI_API_KEY=
# Solicitado por el usuario; disponibilidad exacta no confirmada en catálogo oficial.
OPENAI_MODEL=gpt-6-mini
AI_REQUIRE_EXTERNAL_CONSENT=true
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=400
AI_MAX_INPUT_CHARS=12000
AI_MAX_CALLS_PER_ANALYSIS=4
AI_DAILY_CALL_LIMIT=80
AI_DAILY_TOKEN_LIMIT=160000
# Límite duro por llamadas/tokens; el límite monetario real se fija en OpenAI.
WEBHOOK_NOTIFICATIONS_ENABLED=false
OUTBOUND_WEBHOOK_URL=http://n8n:5678/webhook/vigia-alerts
WEBHOOK_SHARED_KEY=
WEBHOOK_TIMEOUT_SECONDS=10
# En producción, solo permite el destino fijo http://n8n:5678/webhook/vigia-alerts.
WEBHOOK_ALLOW_INTERNAL_HTTP=false
N8N_IMAGE=n8nio/n8n:2.44.4
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
ALERT_RECIPIENT=alerts@vigia.local
N8N_EMAIL_ENABLED=false
REPORT_SCHEDULE_CRON=0 8 * * 1
# Solo zona horaria de automatizaciones; cada cuenta toma la del navegador al primer acceso.
AUTOMATION_TIMEZONE=America/Lima
LANGFLOW_IMAGE=langflowai/langflow:1.6.5
LANGFLOW_PORT=7860
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_SECRET_KEY=
LANGFLOW_AUTO_LOGIN=false
EXTENSION_API_BASE=http://localhost:8000/api/v1
EXTENSION_CACHE_SECONDS=300
EXTENSION_TIMEOUT_MS=8000
# Variables públicas de build React. Requiere rebuild para aplicar cambios.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:8000
VITE_APP_NAME=Vigía Financiera
VITE_APP_SHORT_NAME=VIGÍA
VITE_ORGANIZATION=Laboratorio de seguridad financiera
VITE_ACCENT_COLOR="#2bd8ae"
VITE_POLL_INTERVAL_MS=5000
# Modo Vercel frontend con proxy hacia la API Docker pública HTTPS.
DEPLOYMENT_API_ORIGIN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
