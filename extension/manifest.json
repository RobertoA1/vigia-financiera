{
  "manifest_version": 3,
  "name": "Vigía Financiera",
  "description": "Evalúa indicadores de phishing financiero con controles de privacidad explícitos.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage"],
  "optional_permissions": ["webNavigation", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Vigía Financiera"},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"}
}
