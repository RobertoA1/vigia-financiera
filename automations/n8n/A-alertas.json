{
  "id": "e600a88e-099c-5aff-b091-67d7b2d7732c",
  "name": "A · Alertas de riesgo",
  "nodes": [
    {
      "id": "b1f199da-cc6b-53e6-ae5e-1dffa33dd692",
      "name": "Webhook autenticado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "vigia-alerts",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "736bbbf9-3c01-5d09-a47b-953f7a28bab6",
      "credentials": {
        "httpHeaderAuth": {
          "id": "vigia-header-auth",
          "name": "Vigia webhook key"
        }
      }
    },
    {
      "id": "07bbb82d-a300-5d82-a37d-c47cf48a5651",
      "name": "Registrar evento idempotente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        110,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTERNAL_API_URL + '/webhooks/events' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "={{ $env.WEBHOOK_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}"
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "230070c0-42bb-502b-bbb1-38cdeae0102c",
      "name": "Validar evento",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "97c7e5b5-3214-5844-9a84-7cfc68cd850d",
              "leftValue": "={{ $json.duplicate === false && $(\"Webhook autenticado\").item.json.body.type === \"risk.alert\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0d774259-c18f-5d38-8551-91e017c4fb9d",
      "name": "Correo autorizado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "99fada4a-680e-5b11-b6d3-4b3ae0e76785",
              "leftValue": "={{ $env.EMAIL_NOTIFICATIONS_ENABLED === \"true\" && $(\"Webhook autenticado\").item.json.body.data.notification_allowed === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4132eca6-a78f-597d-9a5d-16ac153ec2c0",
      "name": "Notificación por correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $env.ALERT_RECIPIENT }}",
        "subject": "={{ \"Vigía Financiera · \" + $(\"Webhook autenticado\").item.json.body.type }}",
        "emailFormat": "text",
        "text": "={{ \"Se requiere revisión de indicadores. Evento: \" + $(\"Webhook autenticado\").item.json.body.event_id + \"\\nAbra la consola: \" + $env.APP_URL + \"/incidentes\\nNo visite enlaces sospechosos desde el correo.\" }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "vigia-smtp",
          "name": "Vigia SMTP"
        }
      }
    },
    {
      "id": "715fede4-8c1f-5304-906a-3b6f25e5c96b",
      "name": "Registrar entrega",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTERNAL_API_URL + '/webhooks/notifications' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "={{ $env.WEBHOOK_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event_id: $(\"Webhook autenticado\").item.json.body.event_id, status: \"accepted\", channel: \"email\", detail: \"Entrega aceptada por SMTP; no confirma lectura.\"} }}"
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "835ea044-22e1-576d-a509-33f09b113b55",
      "name": "Registrar omisión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTERNAL_API_URL + '/webhooks/notifications' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "={{ $env.WEBHOOK_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event_id: $(\"Webhook autenticado\").item.json.body.event_id, status: \"accepted\", channel: \"email\", detail: \"Correo desactivado o sin consentimiento.\"} }}"
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "9e68c54c-cdec-5149-98ac-dc022193e4fe",
      "name": "Riesgo crítico",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "41905fd3-32ea-5313-87d6-b62b5995dcf0",
              "leftValue": "={{ $(\"Webhook autenticado\").item.json.body.data.risk === \"critical\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ba23f898-33ad-5c17-ac5f-6aad1d2e5bc2",
      "name": "Activar escalamiento B",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.N8N_INTERNAL_URL || 'http://n8n:5678') + '/webhook/vigia-escalations' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "={{ $env.WEBHOOK_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event_id: $(\"Webhook autenticado\").item.json.body.event_id + \"-escalation\", type:\"incident.escalate\", data: $(\"Webhook autenticado\").item.json.body.data} }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    }
  ],
